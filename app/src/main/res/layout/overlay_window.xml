<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:background="#99000000" android:padding="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
    <LinearLayout android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NETFLIX 屏显" android:textColor="#E50914" android:textSize="9sp" android:textStyle="bold"/>
        <TextView android:id="@+id/btnClose" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  ✕" android:textColor="#888888" android:textSize="9sp" android:paddingStart="8dp"/>
    </LinearLayout>
    <TextView android:id="@+id/tvLine1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Resolution: 1920x1080 (推测) | FHD" android:textColor="#FFFFFF" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="4dp"/>
    <TextView android:id="@+id/tvLine2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bitrate: 5.82 Mbps (5820 kbps)" android:textColor="#00FF88" android:textSize="13sp" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginTop="2dp"/>
    <TextView android:id="@+id/tvHint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="*网络估算，非DRM真实值 | 拖动移动" android:textColor="#666666" android:textSize="8sp" android:layout_marginTop="4dp"/>
</LinearLayout>
